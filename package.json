{
  "name": "pangea-recipes",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:deploy": "turbo run db:deploy",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm run -F=database db:migrate",
    "db:nuke": "turbo run db:nuke",
    "db:studio": "pnpm run -F=database db:studio",
    "dev": "turbo run dev",
    "dx": "turbo run dx",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint:eslint lint:type-check",
    "preview-emails": "pnpm run -F=email preview",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "oxfmt": "^0.43.0",
    "turbo": "^2.9.8"
  },
  "engines": {
    "node": "^24.14.0"
  },
  "packageManager": "pnpm@11.0.5"
}
