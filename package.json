{
  "name": "pangea-recipes",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "db:deploy": "turbo run db:deploy",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm run -F=database db:migrate",
    "db:nuke": "turbo run db:nuke",
    "db:studio": "pnpm run -F=database db:studio",
    "dev": "turbo run dev",
    "dx": "turbo run dx",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview-emails": "pnpm run -F=email preview",
    "test": "turbo run test"
  },
  "devDependencies": {
    "eslint-plugin-turbo": "^2.11.13",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
