{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": []
    },
    "dx": {
      "cache": false
    },
    "db:generate": {},
    "//#format:check": {},
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    }
  },
  "ui": "tui"
}
